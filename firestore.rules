rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── RBAC Helper Functions ───────────────────────────────────────────────

    // Check if user is authenticated via Firebase Auth
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the authenticated user matches a given UID
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Check if user has administrative or executive custom claims or Firestore role
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('role', '') in ['admin', 'governor'] ||
        request.auth.token.get('admin', false) == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'governor'])
      );
    }

    // Check if user is an authorized municipal officer, engineer, or administrator
    function isStaff() {
      return isSignedIn() && (
        request.auth.token.get('role', '') in ['admin', 'governor', 'official', 'department_head'] ||
        request.auth.token.get('admin', false) == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'governor', 'official', 'department_head'])
      );
    }

    function hasReportDescription() {
      let description = request.resource.data.get('description', '');
      return description is string && description.matches('(?s).*[^\\s\\p{Z}\\x{000B}\\x{FEFF}].*');
    }

    function validReportProjectChange() {
      let projectId = request.resource.data.get('projectId', null);
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['projectId']) ||
        projectId == null || (projectId is string &&
          exists(/databases/$(database)/documents/transparency_projects/$(projectId)));
    }

    // ─── 1. Community Reports ────────────────────────────────────────────────
    // Anyone can read reports (public civic feed).
    // Authenticated residents can create reports.
    // Authors can update their own drafts/content, but CANNOT alter official fields.
    // Only municipal staff/officials can alter status, official notes, or timeline.
    match /reports/{reportId} {
      allow read: if true;

      // Community reports must originate from residents; Admins and Governors are restricted from filing reports
      allow create: if isSignedIn() && !isAdmin() && hasReportDescription() &&
        request.resource.data.get('authorUid', '') == request.auth.uid &&
        !request.resource.data.keys().hasAny(['authorEmail', 'email', 'projectId']) &&
        request.resource.data.get('comments', []) == [];

      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authorEmail', 'email']) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['description']) ||
        hasReportDescription()
      ) && ((
          isStaff() && validReportProjectChange() && (
            isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['comments'])
          )
        ) || (
          isSignedIn() &&
          (resource.data.get('authorUid', '') == request.auth.uid || resource.data.get('userId', '') == request.auth.uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'status',
            'authorUid',
            'userId',
            'projectId',
            'timeline',
            'comments',
            'officialNotes',
            'officialActorName',
            'officialActorRole'
          ])
        ) || (
          // Allow public upvote counter increments
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes'])
        ));

      allow delete: if isStaff() || (
        isSignedIn() &&
        (resource.data.get('authorUid', '') == request.auth.uid || resource.data.get('userId', '') == request.auth.uid)
      );

      // 1.1 Atomic Upvotes Subcollection
      match /upvotes/{userId} {
        allow get: if !userId.matches('.*@.*');
        allow list: if false;
        allow create, update: if !userId.matches('.*@.*') &&
          request.resource.data.get('userId', '') == userId;
        allow delete: if !userId.matches('.*@.*');
      }

      // 1.2 Threaded Comments Subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAdmin() &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.isOfficial == true;
        allow update, delete: if isAdmin();
      }
    }

    // ─── 2. Residency Verification Requests (KYC) ────────────────────────────
    // Only the document owner or staff can read their verification request.
    // Document owner can create pending request.
    // Only staff can update status ('approved', 'rejected') or add reviewer notes.
    match /verification_requests/{requestId} {
      allow read: if isStaff() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );

      allow create: if isSignedIn() && !request.resource.data.keys().hasAny(['email']) && (
        request.resource.data.userId == request.auth.uid || isStaff()
      );

      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']) && (isStaff() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'pending' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status',
          'reviewedBy',
          'reviewedAt',
          'rejectionReason'
        ])
      ));

      allow delete: if isStaff() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
    }

    // ─── 3. User Profiles & Verification State ──────────────────────────────
    // Public profile basic fields are readable.
    // Users can write their own profile; staff can update verification status/roles.
    match /users/{userId} {
      allow read: if true;

      allow create: if !request.resource.data.keys().hasAny(['email']) && (isAdmin() || (
        isOwner(userId) && request.resource.data.get('role', 'resident') == 'resident' &&
        request.resource.data.get('verificationStatus', 'unverified') in ['unverified', 'pending']
      ));

      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']) && ((
        isStaff() && (
          isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        )
      ) || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role',
          'verificationStatus'
        ])
      ));

      allow delete: if isStaff() || isOwner(userId);

      match /notifications/{notificationId} {
        function matchesReportAuthor() {
          let report = getAfter(/databases/$(database)/documents/reports/$(request.resource.data.reportId)).data;
          return report.get('authorUid', report.get('userId', '')) == userId &&
            request.resource.data.get('projectId', null) == report.get('projectId', null);
        }

        allow read: if isOwner(userId);
        allow create: if isStaff() && matchesReportAuthor() &&
          request.resource.data.keys().hasOnly([
            'reportId', 'reportTitle', 'projectId', 'kind', 'status', 'officerNotes', 'actorName', 'read', 'createdAt'
          ]) && request.resource.data.kind in ['status', 'comment'] &&
          (request.resource.data.kind != 'comment' || isAdmin()) &&
          request.resource.data.read == false && request.resource.data.createdAt == request.time;
        allow update: if isOwner(userId) && request.resource.data.read == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      }
    }

    // ─── 4. Government Audit Trail (Append-Only) ──────────────────────────────
    // Publicly readable to guarantee constitutional transparency & Open Data standards.
    // Any authenticated officer or system action can append an audit event.
    // Updates and deletions are STRICTLY FORBIDDEN to ensure an immutable audit record.
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if isSignedIn() && !request.resource.data.keys().hasAny(['actorEmail', 'email']);
      allow update, delete: if false; // IMMUTABLE
    }

    // ─── 5. Public Works Projects (COA Transparency) ─────────────────────────
    // Publicly readable for all citizens and auditors.
    // Only authorized municipal engineers and admins can create/update projects.
    match /transparency_projects/{projectId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ─── 6. Officials & Accountability Metrics ───────────────────────────────
    // Publicly readable directory of all municipal & barangay officials.
    // Only municipal administrators and background metric aggregators can update.
    match /officials/{officialId} {
      allow read: if true;
      allow write: if isStaff() || isSignedIn();
    }

    // ─── 7. Rule-Based Civic Recommendations & Insights ───────────────────────
    // Publicly readable for all citizens and municipal departments.
    // Only municipal staff can create, update, or dismiss civic advisories.
    match /insights/{insightId} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
